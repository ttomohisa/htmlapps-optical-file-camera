{
  "$schema": "./schemas/dependencies.schema.json",
  "dependencies": [
    {
      "id": "qrcode",
      "package": "qrcode",
      "version": "1.4.4",
      "license": "MIT",
      "homepage": "https://github.com/soldair/node-qrcode",
      "assets": [
        {
          "key": "browser",
          "path": "build/qrcode.min.js",
          "mime": "text/javascript",
          "stripSourceMapComment": true
        }
      ]
    },
    {
      "id": "jsqr",
      "package": "jsqr",
      "version": "1.4.0",
      "license": "Apache-2.0",
      "homepage": "https://github.com/cozmo/jsQR",
      "assets": [
        {
          "key": "main",
          "path": "dist/jsQR.js",
          "mime": "text/javascript",
          "stripSourceMapComment": true
        }
      ]
    }
  ]
}
